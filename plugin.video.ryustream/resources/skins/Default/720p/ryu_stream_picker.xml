            <font>font13</font><textcolor>FFE2E8F0</textcolor>
            <label>$INFO[Window.Property(RyuStreamCount)] files</label>
        </control>
        <control type="list" id="5001">
            <left>270</left><top>112</top><width>970</width><height>535</height>
            <orientation>vertical</orientation><itemgap>5</itemgap>
            <onleft>5001</onleft><onright>5001</onright>
            <itemlayout height="58" width="970">
                <control type="image">
                    <left>0</left><top>0</top><width>970</width><height>58</height>
                    <texture colordiffuse="CC111827">white.png</texture>
                </control>
                <control type="label">
                    <left>17</left><top>2</top><width>930</width><height>54</height>
                    <font>font13</font><textcolor>FFE2E8F0</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout height="58" width="970">
                <control type="image">
                    <left>0</left><top>0</top><width>970</width><height>58</height>
                    <texture colordiffuse="EE0F766E">white.png</texture>
                </control>
                <control type="label">
                    <left>17</left><top>2</top><width>930</width><height>54</height>
                    <font>font13</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>
        <control type="label">
            <left>270</left><top>664</top><width>970</width><height>34</height>
            <font>font12</font><textcolor>FFCBD5E1</textcolor><align>center</align>
            <label>UP / DOWN to browse   |   ENTER to select   |   BACK to cancel</label>
        </control>
