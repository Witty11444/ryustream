        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1280</width><height>720</height>
            <texture colordiffuse="B807111E">white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1280</width><height>96</height>
            <texture colordiffuse="E607111E">white.png</texture>
        </control>
        <control type="label">
            <left>46</left><top>12</top><width>1150</width><height>44</height>
            <font>font16</font><textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(RyuTitle)]</label>
        </control>
        <control type="label">
            <left>48</left><top>55</top><width>1160</width><height>32</height>
            <font>font13</font><textcolor>FF10E6BC</textcolor>
            <label>$INFO[Window.Property(RyuQualityCounts)]</label>
