            <left>38</left><top>112</top><width>210</width><height>535</height>
            <texture colordiffuse="CC07111E">white.png</texture>
        </control>
        <control type="label">
            <left>56</left><top>145</top><width>175</width><height>50</height>
            <font>font14</font><textcolor>FF10E6BC</textcolor>
