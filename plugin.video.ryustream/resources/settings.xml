<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="1. Debrid Accounts">
        <setting label="[COLOR cyan]AllDebrid (Recommended)[/COLOR]" type="lsep"/>
        <setting id="enable_ad" type="bool" label="Enable AllDebrid Cloud" default="true"/>
        <setting id="ad_apikey" type="text" label="AllDebrid API Key" default="" enable="false"/>
        <setting id="ad_username" type="text" label="AllDebrid User" default="-" enable="false"/>
        <setting type="action" label="&gt;&gt; Authorize AllDebrid (PIN) &lt;&lt;" action="RunPlugin(plugin://plugin.video.ryustream/?action=auth_alldebrid)"/>
        <setting type="sep"/>

        <setting label="[COLOR gold]TorBox &amp; Real-Debrid (Optional)[/COLOR]" type="lsep"/>
        <setting id="enable_tb" type="bool" label="Enable TorBox Cloud" default="true"/>
        <setting id="tb_apikey" type="text" label="TorBox API Key" default="" enable="eq(-1,true)"/>
        <setting id="enable_rd" type="bool" label="Enable Real-Debrid Cloud" default="true"/>
        <setting id="rd_apikey" type="text" label="Real-Debrid API Token" default="" enable="eq(-1,true)"/>
        <setting id="enable_pm" type="bool" label="Enable Premiumize Cloud" default="true"/>
        <setting id="pm_apikey" type="text" label="Premiumize Access Token" default="" enable="eq(-1,true)"/>
        <setting type="sep"/>

        <setting id="quality_filter" type="text" label="Preferred Video Quality" default="All (4K / 1080p / 720p)" visible="false"/>
        <setting id="scraper_mode" type="text" label="Scraper Engine" default="Internal" visible="false"/>

        <setting label="TH Support: LINE ID @631llmic | Global: ://buymeacoffee.com" type="lsep"/>
    </category>

    <category label="2. Trakt / Simkl / MDBList">
        <setting label="[COLOR lime]Trakt.tv[/COLOR]" type="lsep"/>
        <setting id="trakt_token" type="text" label="Trakt Access Token" default="" enable="false"/>
        <setting type="action" label="&gt;&gt; Authorize Trakt (PIN) &lt;&lt;" action="RunPlugin(plugin://plugin.video.ryustream/?action=auth_trakt)"/>
        <setting type="sep"/>

        <setting label="[COLOR cyan]Simkl.com[/COLOR]" type="lsep"/>
        <setting id="simkl_token" type="text" label="Simkl Access Token" default="" enable="false"/>
        <setting type="action" label="&gt;&gt; Authorize Simkl (PIN) &lt;&lt;" action="RunPlugin(plugin://plugin.video.ryustream/?action=auth_simkl)"/>
        <setting type="sep"/>

        <setting label="[COLOR gold]MDBList.com[/COLOR]" type="lsep"/>
        <setting id="mdblist_apikey" type="text" label="MDBList API Key" default=""/>
    </category>

    <category label="3. Metadata (TMDb)">
        <setting id="tmdb_apikey" type="text" label="TMDb API Key (v3)" default=""/>
    </category>

    <category label="4. Subtitles (SubMaker)">
        <setting label="[COLOR cyan]SubMaker ElfHosted subtitles[/COLOR]" type="lsep"/>
        <setting id="submaker_url" type="text" label="SubMaker install / manifest URL (optional)" default=""/>
    </category>

    <category label="5. Maintenance">
        <setting label="[COLOR cyan]Manage Local Cache (SQLite)[/COLOR]" type="lsep"/>
        <setting type="action" label="1. Clear Metadata Cache (TMDb)" action="RunPlugin(plugin://plugin.video.ryustream/?action=clear_cache&amp;type=tmdb)"/>
        <setting type="action" label="2. Clear Lists Cache (Trakt / Simkl / MDBList)" action="RunPlugin(plugin://plugin.video.ryustream/?action=clear_cache&amp;type=lists)"/>
        <setting type="action" label="3. Clear All Cache &amp; Optimize DB" action="RunPlugin(plugin://plugin.video.ryustream/?action=clear_cache&amp;type=all)"/>
    </category>
</settings>
