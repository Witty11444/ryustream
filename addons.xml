<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.ryustream" name="RyuStream Repository" version="1.1.5" provider-name="RyuStream">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="RyuStream Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/Witty11444/ryustream/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/Witty11444/ryustream/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/Witty11444/ryustream/main/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Official Repository for RyuStream Kodi Add-on</summary>
    <description lang="en_GB">Install and receive automatic updates for RyuStream.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="plugin.video.ryustream" name="RyuStream" version="3.2.4" provider-name="RyuStream">
  <requires>
    <import addon="xbmc.python" version="3.2.4"/>
    <import addon="script.module.requests" version="2.22.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">RyuStream - Lightweight Debrid &amp; Cloud Media Hub</summary>
    <description lang="en_GB">Fast, ultra-lightweight Kodi video addon with QR Device Auth, Internal Scrapers, and Multi-Debrid support.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
</addons>
